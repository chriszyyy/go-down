.settings-scroll {
    flex-grow: 1;
}

.settings-scroll #unity-content-container {
    padding-bottom: 12px;
    padding-left: 4px;
    padding-right: 4px;
}

.audio-row {
    flex-direction: row;
    align-items: center;
    height: 110px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.audio-icon {
    width: 80px;
    height: 80px;
    margin-right: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.audio-icon--music {
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=527104351&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#music-icon");
}

.audio-icon--sfx {
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=140152964&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#sound-icon");
}

.audio-slider {
    flex-grow: 1;
    height: 60px;
    margin-left: 12px;
    margin-right: 18px;
}

/* 滑块的 input 容器：去掉 Unity 默认的 padding，确保 tracker 和 dragger 都从 0 起算，
   避免 knob 在最左/最右时与 tracker 边缘有半像素 offset。 */
.audio-slider .unity-base-slider__input {
    padding: 0;
    margin: 0;
}

.audio-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=1507802591&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#progress-bar-empty");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    border-radius: 0;
    height: 32px;
    top: 50%;
    margin-top: -16px;
}

.audio-slider__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
}

.audio-slider__fill-image {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=-2106050260&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#progress-bar-full");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    border-radius: 0;
}

.audio-slider .unity-base-slider__dragger {
    width: 50px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=536652276&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#toggle-round-dot");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-radius: 0;
    /* 不设 margin-left：Unity 默认会把 dragger.left 从 0 到 (trackerWidth - draggerWidth) 进行插值，
       这样拖动球完全在 tracker 内部，不会两端外翻。填充以像素计算为
       knob.left = pct * (trackerWidth - draggerWidth)，与拖动球左边缘对齐。 */
    top: 50%;
    margin-top: -25px;
    margin-left: 0;
}

.audio-slider .unity-base-slider__dragger-border {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.audio-toggle {
    flex-direction: row;
    justify-content: flex-end;
    margin-left: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.audio-toggle .unity-toggle__input {
    width: 170px;
    height: 56px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=763782775&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#off-toggle-without-round-dot");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

.audio-toggle:checked .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/sound-controls.png?fileID=416846405&guid=cf7bc4aca57f2e040b96645f60b24de8&type=3#on-toggle-without-round-dot");
}

.audio-toggle .unity-toggle__checkmark {
    display: none;
}

.audio-toggle:active {
    scale: 0.96 0.96;
}
