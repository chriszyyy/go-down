:root {
    --color-bg-deep: rgb(8, 12, 30);
    --color-bg-dark: rgb(15, 22, 50);
    --color-pill-bg: rgba(20, 28, 60, 0.92);
    --color-pill-border: rgb(80, 140, 255);
    --color-icon-bg: rgba(20, 28, 60, 0.92);
    --color-icon-border: rgb(80, 140, 255);
    --color-text: rgb(240, 240, 245);
    --color-text-muted: rgb(180, 190, 215);
    --color-text-dark: rgb(60, 35, 5);
    --color-play: rgb(250, 188, 60);
    --color-play-hi: rgb(255, 215, 110);
    --color-play-shadow: rgb(190, 120, 25);
    --color-shop: rgb(70, 150, 255);
    --color-shop-hi: rgb(120, 185, 255);
    --color-settings: rgb(140, 95, 240);
    --color-settings-hi: rgb(175, 140, 255);
    --color-flag: rgb(240, 70, 70);
    --color-gem: rgb(230, 60, 80);
    --color-coin: rgb(255, 200, 60);
    --radius-sm: 12px;
    --radius-md: 22px;
    --radius-lg: 36px;
    --radius-pill: 999px;
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-deep);
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 48px;
    padding-bottom: 56px;
}

/* 全屏背景图（占满整个 screen，位于所有内容之下） */
.bg-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BG.png");
    -unity-background-scale-mode: scale-and-crop;
    /* 让上面的内容稍微更醒目，淡淡压暗一下背景 */
    background-color: rgba(0, 0, 0, 0.18);
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
}

.stat-pill {
    flex-direction: row;
    align-items: center;
    height: 80px;
    min-width: 230px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--color-pill-bg);
    border-radius: var(--radius-pill);
    border-width: 3px;
    border-color: var(--color-pill-border);
}

.stat-pill__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    margin-right: var(--space-sm);
}

.stat-pill__icon--flag {
    background-color: var(--color-flag);
}

.stat-pill__icon--gem {
    background-color: var(--color-gem);
}

.stat-pill__icon--coin {
    background-color: var(--color-coin);
}

.stat-pill__value {
    flex-grow: 1;
    color: var(--color-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: var(--space-xs);
    margin-right: var(--space-xs);
}

.stat-pill__plus {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border-width: 0;
    background-color: rgb(80, 140, 255);
    color: var(--color-text);
    font-size: 28px;
    -unity-font-style: bold;
    padding: 0;
}

.stat-pill__plus:hover {
    background-color: rgb(120, 170, 255);
}

.stat-pill__plus:active {
    scale: 0.92 0.92;
}

.middle-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
}

.side-rail {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 130px;
    padding-top: 12px;
}

.icon-btn {
    width: 110px;
    height: 110px;
    border-radius: var(--radius-pill);
    border-width: 3px;
    border-color: var(--color-icon-border);
    background-color: var(--color-icon-bg);
    margin-bottom: 6px;
    padding: 0;
    color: var(--color-text);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.icon-btn:hover {
    background-color: rgba(40, 60, 110, 0.95);
}

.icon-btn:active {
    scale: 0.94 0.94;
}

.icon-btn__caption {
    color: var(--color-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    letter-spacing: 1px;
}

.center-stack {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: var(--space-sm);
}

.logo {
    color: var(--color-play);
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    letter-spacing: 6px;
}

/* Logo 图片版本：使用 PNG 作为背景，保留原始宽高比 */
.logo-img {
    width: 720px;
    height: 396px;
    margin-top: 40px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_Logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.subtitle {
    color: var(--color-text);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-top: 18px;
    margin-bottom: var(--space-md);
    white-space: normal;
}

.bottom-actions {
    flex-direction: column;
    align-items: center;
    margin-bottom: 12px;
}

/* 按钮本体：使用 PNG 作为背景。三张贴图原始宽度略有差异（348/338/324），
   使用 stretch-to-fill 强制填充到同一容器尺寸，保证三个按钮可视大小完全一致。
   变形在这种胶囊形状上几乎看不出来。 */
.btn {
    width: 700px;
    height: 195px;
    margin-top: 18px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 100ms;
}

.btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.btn:active {
    scale: 0.97 0.97;
}

/* 按钮上的文字，统一白色 + 深色描边，三个按钮保持一致 */
.btn__label {
    color: rgb(255, 255, 255);
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgba(20, 20, 35, 0.9);
    margin: 0;
    padding: 0;
    /* 预留：当加入 .btn__icon 后，文字会被推到右边。 */
}

/* 按钮内的图标，scale-to-fit 保持原始宽高比，绝对不变形。
   三张图原始比例略有差异（Play 0.85:1 / Shop 1.10:1 / Setting 1.13:1），
   会有轻微大小差异，但不会拉伸变形。 */
.btn__icon {
    width: 100px;
    height: 100px;
    margin-right: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.btn__icon--play {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconPlay.png");
}

.btn__icon--shop {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconShop.png");
}

.btn__icon--settings {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconSetting.png");
}

/* 各按钮的 PNG 贴图 */
.btn--play {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnPlay.png");
}

.btn--shop {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnShop.png");
}

.btn--settings {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnSetting.png");
}

.panel {
    min-width: 360px;
    padding: var(--space-lg);
    background-color: rgba(28, 32, 50, 0.95);
    border-radius: var(--radius-md);
    align-items: stretch;
}

.panel__title {
    font-size: 32px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.panel__subtitle {
    font-size: 16px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-md);
}

.btn--secondary {
    background-color: rgba(255, 255, 255, 0.08);
}
