:root {
    --color-bg-deep: rgb(8, 12, 30);
    --color-bg-dark: rgb(15, 22, 50);
    --color-pill-bg: rgba(20, 28, 60, 0.92);
    --color-pill-border: rgb(80, 140, 255);
    --color-icon-bg: rgba(20, 28, 60, 0.92);
    --color-icon-border: rgb(80, 140, 255);
    --color-text: rgb(240, 240, 245);
    --color-text-muted: rgb(180, 190, 215);
    --color-text-dark: rgb(60, 35, 5);
    --color-play: rgb(250, 188, 60);
    --color-play-hi: rgb(255, 215, 110);
    --color-play-shadow: rgb(190, 120, 25);
    --color-shop: rgb(70, 150, 255);
    --color-shop-hi: rgb(120, 185, 255);
    --color-settings: rgb(140, 95, 240);
    --color-settings-hi: rgb(175, 140, 255);
    --color-flag: rgb(240, 70, 70);
    --color-gem: rgb(230, 60, 80);
    --color-coin: rgb(255, 200, 60);
    --radius-sm: 12px;
    --radius-md: 22px;
    --radius-lg: 36px;
    --radius-pill: 999px;
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-deep);
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 130px;
    padding-bottom: 56px;
}

.bg-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BG.png?fileID=21300000&guid=9b7fccdda5cd003408364df676766bd9&type=3#StartMenu_BG");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0.18);
}

.bg-image--page {
    background-image: url("project://database/Assets/UI/Sprites/PageBG.png?fileID=21300000&guid=7e4389102c1df4b40861b62fd5d4266c&type=3#PageBG");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0.3);
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
}

.stat-pill {
    flex-direction: row;
    align-items: center;
    height: 80px;
    min-width: 230px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--color-pill-bg);
    border-radius: var(--radius-pill);
    border-width: 3px;
    border-color: var(--color-pill-border);
}

.stat-pill__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    margin-right: var(--space-sm);
}

.stat-pill__icon--flag {
    background-color: var(--color-flag);
}

.stat-pill__icon--gem {
    background-color: var(--color-gem);
}

.stat-pill__icon--coin {
    background-color: var(--color-coin);
}

.stat-pill__value {
    flex-grow: 1;
    color: var(--color-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: var(--space-xs);
    margin-right: var(--space-xs);
}

.stat-pill__plus {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border-width: 0;
    background-color: rgb(80, 140, 255);
    color: var(--color-text);
    font-size: 28px;
    -unity-font-style: bold;
    padding: 0;
}

.stat-pill__plus:hover {
    background-color: rgb(120, 170, 255);
}

.stat-pill__plus:active {
    scale: 0.92 0.92;
}

.middle-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
}

.side-rail {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 130px;
    padding-top: 12px;
}

.icon-btn {
    width: 110px;
    height: 110px;
    border-radius: var(--radius-pill);
    border-width: 3px;
    border-color: var(--color-icon-border);
    background-color: var(--color-icon-bg);
    margin-bottom: 6px;
    padding: 0;
    color: var(--color-text);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.icon-btn:hover {
    background-color: rgba(40, 60, 110, 0.95);
}

.icon-btn:active {
    scale: 0.94 0.94;
}

.icon-btn__caption {
    color: var(--color-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    letter-spacing: 1px;
}

.center-stack {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: var(--space-sm);
}

.logo {
    color: var(--color-play);
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    letter-spacing: 6px;
}

.logo-img {
    width: 720px;
    height: 396px;
    margin-top: 40px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_Logo.png?fileID=21300000&guid=a68efdb8832ab9a49abb8e4d2c485747&type=3#StartMenu_Logo");
    -unity-background-scale-mode: scale-to-fit;
}

.subtitle {
    color: var(--color-text);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-top: 18px;
    margin-bottom: var(--space-md);
    white-space: normal;
}

.bottom-actions {
    flex-direction: column;
    align-items: center;
    margin-bottom: 12px;
}

.btn {
    width: 700px;
    height: 195px;
    margin-top: 18px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 100ms;
}

.btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.btn:active {
    scale: 0.97 0.97;
}

.btn__label {
    color: rgb(255, 255, 255);
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgba(20, 20, 35, 0.9);
    margin: 0;
    padding: 0;
}

.btn__icon {
    width: 100px;
    height: 100px;
    margin-right: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.btn__icon--play {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconPlay.png?fileID=21300000&guid=7d2501f23ecdb444e9904250b018ecc5&type=3#StartMenu_IconPlay");
}

.btn__icon--shop {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconShop.png?fileID=21300000&guid=d8009a69340cf264bbcc4b4297385bc8&type=3#StartMenu_IconShop");
}

.btn__icon--settings {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_IconSetting.png?fileID=21300000&guid=74bc84011350345459deade7a654d8bc&type=3#StartMenu_IconSetting");
}

.btn--play {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnPlay.png?fileID=21300000&guid=7833687fafc2db8459430f4826771224&type=3#StartMenu_BtnPlay");
}

.btn--shop {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnShop.png?fileID=21300000&guid=a03a82638bf989043974f24d3b1573ce&type=3#StartMenu_BtnShop");
}

.btn--settings {
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnSetting.png?fileID=21300000&guid=d929dccfd560594468ac0a7ac5d07b41&type=3#StartMenu_BtnSetting");
}

.panel {
    min-width: 360px;
    padding: var(--space-lg);
    background-color: rgba(28, 32, 50, 0.95);
    border-radius: var(--radius-md);
    align-items: stretch;
}

.panel__title {
    font-size: 32px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.panel__subtitle {
    font-size: 16px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-md);
}

.btn--secondary {
    background-color: rgba(255, 255, 255, 0.08);
}

.header-row {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 24px;
}

.back-btn {
    width: 110px;
    height: 110px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/BackBtn.png?fileID=21300000&guid=4c572eaa69642c24e95461e5a4df8ddc&type=3#BackBtn");
    -unity-background-scale-mode: scale-to-fit;
    color: rgba(0, 0, 0, 0);
    padding: 0;
    margin: 0;
    margin-right: 24px;
}

.back-btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.back-btn:active {
    scale: 0.94 0.94;
}

.banner {
    flex-grow: 1;
    height: 110px;
    border-radius: 28px;
    border-width: 3px;
    border-color: var(--color-pill-border);
    background-color: rgba(40, 70, 160, 0.7);
    align-items: center;
    justify-content: center;
}

.banner__title {
    color: var(--color-text);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.section-card {
    background-color: rgba(15, 22, 50, 0.7);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.4);
    padding: 22px;
    margin-bottom: 22px;
}

.section-title {
    color: rgb(120, 180, 255);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 14px;
}

.section-divider {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    margin-bottom: 14px;
}

.section-divider__line {
    height: 2px;
    width: 80px;
    background-color: rgba(120, 180, 255, 0.6);
    margin-left: 14px;
    margin-right: 14px;
}

.section-divider__text {
    color: rgb(120, 180, 255);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.bottom-nav {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 150px;
    background-color: rgba(15, 22, 50, 0.85);
    border-radius: 30px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.5);
    padding-left: 12px;
    padding-right: 12px;
    margin-top: 18px;
}

.nav-btn {
    flex-grow: 1;
    height: 130px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 24px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgb(160, 175, 210);
    font-size: 22px;
    -unity-font-style: bold;
    padding: 0;
    transition-property: background-color, scale;
    transition-duration: 120ms;
}

.nav-btn:hover {
    background-color: rgba(80, 140, 255, 0.15);
}

.nav-btn:active {
    scale: 0.95 0.95;
}

.nav-btn--active {
    background-color: rgba(40, 90, 200, 0.85);
    color: var(--color-text);
    border-width: 2px;
    border-color: rgb(120, 180, 255);
}

.placeholder-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background-color: rgba(180, 200, 230, 0.35);
    margin-bottom: 4px;
}
