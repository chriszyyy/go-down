/* ============================================================
 * shop.uss — 商店面板专属样式
 * 共享部分（顶栏 / header / section-divider / bottom-nav）
 * 已经在 theme.uss。这里只放 shop 自己用到的。
 * ============================================================ */

/* —— Tab 切换条（BALLS / BLOCKS） —— */
.tab-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 18px;
}

.tab-btn {
    width: 280px;
    height: 96px;
    margin-left: 14px;
    margin-right: 14px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.4);
    border-radius: 28px;
    background-color: rgba(15, 22, 50, 0.7);
    color: rgb(150, 170, 210);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    padding: 0;
}

.tab-btn:hover {
    background-color: rgba(40, 70, 130, 0.7);
}

.tab-btn:active {
    scale: 0.97 0.97;
}

.tab-btn--active {
    background-color: var(--color-play);
    color: var(--color-text-dark);
    border-color: var(--color-play-hi);
}

/* —— 商品网格 —— */
.shop-scroll {
    flex-grow: 1;
}

.item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 8px;
}

.item-card {
    width: 30%;
    height: 320px;
    margin-bottom: 18px;
    background-color: rgba(20, 30, 70, 0.85);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.35);
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 14px;
    padding-left: 10px;
    padding-right: 10px;
}

.item-card--selected {
    border-color: rgb(120, 180, 255);
    border-width: 4px;
    background-color: rgba(35, 55, 130, 0.9);
}

.item-card--locked {
    /* 默认外观即“锁定”，预留以后做半透明效果 */
}

/* 商品缩略图占位（六边形球 / 体育球等）——
   后续把背景换成实际 PNG 即可。 */
.item-thumb {
    width: 150px;
    height: 150px;
    border-radius: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-thumb--classic   { background-color: rgb(245, 195, 60);  background-image: url("project://database/Assets/Sprites/HexagonBall.png"); }
.item-thumb--blue      { background-color: rgb(70, 140, 255);  border-radius: 24px; }
.item-thumb--purple    { background-color: rgb(170, 90, 240);  border-radius: 24px; }
.item-thumb--green     { background-color: rgb(80, 200, 110);  border-radius: 24px; }
.item-thumb--red       { background-color: rgb(230, 70, 80);   border-radius: 24px; }
.item-thumb--rainbow   {
    background-color: rgb(160, 110, 230);
    border-radius: 24px;
}
.item-thumb--soccer    { background-color: rgb(240, 240, 240); border-radius: 999px; }
.item-thumb--basket    { background-color: rgb(230, 130, 50);  border-radius: 999px; }
.item-thumb--planet    { background-color: rgb(70, 60, 180);   border-radius: 999px; }

/* 名字 / 价格 标签 */
.item-card__name {
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-top: 4px;
}

.item-card__price {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(80, 50, 160, 0.85);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(150, 110, 240, 0.6);
    height: 56px;
    width: 90%;
    padding-left: 8px;
    padding-right: 12px;
    margin-top: 6px;
}

.item-card__price-coin {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background-color: var(--color-coin);
    margin-right: 8px;
}

.item-card__price-text {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
}

/* 锁标 / 已选标 */
.item-card__lock {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: rgba(220, 220, 230, 0.85);
}

.item-card__check {
    position: absolute;
    bottom: 80px;
    right: 14px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background-color: rgb(70, 200, 90);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

/* ============================================================
 * Tab content panels (BALLS / BLOCKS / ITEMS / COINS / NO ADS)
 * ============================================================ */

.tab-bar--five {
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.tab-btn--small {
    width: 180px;
    height: 70px;
    font-size: 22px;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.tab-content {
    display: flex;
}

.tab-content--hidden {
    display: none;
}

.empty-tab__label {
    color: var(--color-text-muted);
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-top: 100px;
    letter-spacing: 4px;
}

.empty-tab__sub {
    color: var(--color-text-muted);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-top: 24px;
}

.item-grid--two .item-card {
    width: 47%;
}

.item-grid--three .item-card {
    width: 31%;
    height: 280px;
}

.item-card--tool {
    height: 360px;
    padding-top: 18px;
}

.item-card--coin {
    height: 260px;
}

.item-card__title {
    color: var(--color-text);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.item-card__sub {
    color: var(--color-text-muted);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.item-card__count {
    color: rgb(120, 200, 255);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.item-card__ribbon {
    display: none;
}

.item-card__price--money {
    background-color: rgba(80, 140, 255, 0.85);
    border-color: rgba(150, 200, 255, 0.7);
}

.item-thumb--tool-reset {
    background-color: rgb(245, 195, 60);
    border-radius: 24px;
}

.item-thumb--tool-rainbow {
    background-color: rgb(160, 110, 230);
    border-radius: 24px;
}

.item-thumb--coin-pack {
    background-color: rgb(255, 200, 60);
    border-radius: 24px;
}

.noads-hero {
    align-items: center;
    margin-top: 4px;
    margin-bottom: 18px;
    padding-top: 14px;
    padding-bottom: 6px;
}

.noads-hero__title {
    color: rgb(250, 188, 60);
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.noads-hero__subtitle {
    color: var(--color-text);
    font-size: 22px;
    margin-top: 4px;
}

.noads-hero__image {
    width: 460px;
    height: 360px;
    margin-top: 8px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Sprites/NoAds/no-ads-main.png?fileID=21300000&guid=fab63623444519f4eacc851bc7254c0e&type=3#no-ads-main");
}

.noads-features {
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-start;
    margin-top: 4px;
    margin-bottom: 22px;
    padding-left: 12px;
    padding-right: 12px;
}

.noads-feature {
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.noads-feature__icon {
    width: 92px;
    height: 92px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.noads-feature__icon--shield {
    background-image: url("project://database/Assets/UI/Sprites/NoAds/sheild.png?fileID=21300000&guid=6490a9ef4ec8eee43bb7d983c7bb0c8a&type=3#sheild");
}

.noads-feature__icon--playback {
    background-image: url("project://database/Assets/UI/Sprites/NoAds/playback.png?fileID=21300000&guid=7be85e38d01c6354d9d95df0733a4b81&type=3#playback");
}

.noads-feature__icon--rocket {
    background-image: url("project://database/Assets/UI/Sprites/NoAds/rocket.png?fileID=21300000&guid=93d1b78d6569c204a8fe387615503c60&type=3#rocket");
}

.noads-feature__label {
    color: var(--color-text);
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.noads-lifetime-card {
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 18px;
    background-color: rgba(15, 22, 50, 0.7);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.4);
}

.noads-lifetime-card__title {
    color: var(--color-text);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.noads-lifetime-card__sub {
    color: var(--color-text-muted);
    font-size: 20px;
    margin-top: 4px;
}

.noads-lifetime-card__icon {
    width: 210px;
    height: 140px;
    margin-top: 8px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Sprites/NoAds/infinite.png?fileID=21300000&guid=44a5b8e3bd06ed44a80ded78e8b1bb9a&type=3#infinite");
}

.noads-lifetime-card__tagline {
    color: rgb(120, 200, 255);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.noads-price-btn {
    width: 80%;
    height: 110px;
    color: rgb(60, 40, 10);
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 13;
    -unity-slice-top: 12;
    -unity-slice-right: 13;
    -unity-slice-bottom: 12;
    background-image: url("project://database/Assets/UI/Sprites/StartMenu_BtnPlay.png?fileID=21300000&guid=7833687fafc2db8459430f4826771224&type=3#StartMenu_BtnPlay");
}

.noads-price-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.noads-price-btn:active {
    background-color: rgba(0, 0, 0, 0.15);
}

.noads-restore-card {
    flex-direction: row;
    align-items: center;
    padding: 18px;
    margin-bottom: 8px;
    background-color: rgba(15, 22, 50, 0.6);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.3);
}

.noads-restore-card__icon {
    width: 60px;
    height: 60px;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Sprites/NoAds/refresh.png?fileID=21300000&guid=5259d766b9f4d304b8d4299b09eeb256&type=3#refresh");
}

.noads-restore-card__text {
    flex-grow: 1;
    flex-direction: column;
}

.noads-restore-card__title {
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.noads-restore-card__sub {
    color: var(--color-text-muted);
    font-size: 18px;
    margin-top: 2px;
}

/* ============================================================
 * Buy Modal
 * ============================================================ */

.buy-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.buy-modal--hidden {
    display: none;
}

.buy-modal__panel {
    width: 80%;
    background-color: rgba(15, 22, 50, 0.97);
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(80, 140, 255);
    padding: 32px;
    align-items: stretch;
}

.buy-modal__view {
    display: flex;
    align-items: center;
}

.buy-modal__view--hidden {
    display: none;
}

.buy-modal__title {
    color: rgb(240, 240, 245);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 18px;
}

.buy-modal__close {
    position: absolute;
    top: 0;
    right: 0;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background-color: rgba(80, 140, 255, 0.3);
    border-width: 0;
    color: rgb(240, 240, 245);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
}

.buy-modal__icon {
    width: 130px;
    height: 130px;
    margin-bottom: 14px;
}

.buy-modal__item-name {
    color: rgb(120, 180, 255);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 14px;
}

.buy-modal__prompt {
    color: rgb(180, 190, 215);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.buy-modal__qty-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.buy-modal__qty-btn {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background-color: rgba(80, 140, 255, 0.5);
    border-width: 0;
    color: rgb(240, 240, 245);
    font-size: 32px;
    -unity-font-style: bold;
    padding: 0;
    margin-left: 8px;
    margin-right: 8px;
}

.buy-modal__qty-value {
    width: 100px;
    color: rgb(240, 240, 245);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(20, 30, 70, 0.85);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.5);
    padding-top: 10px;
    padding-bottom: 10px;
    margin-left: 8px;
    margin-right: 8px;
}

.buy-modal__qty-max {
    width: 80px;
    height: 64px;
    border-radius: 14px;
    background-color: rgba(80, 140, 255, 0.85);
    border-width: 0;
    color: rgb(240, 240, 245);
    font-size: 22px;
    -unity-font-style: bold;
    padding: 0;
    margin-left: 12px;
}

.buy-modal__total {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(80, 50, 160, 0.85);
    border-radius: 14px;
    height: 64px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 18px;
}

.buy-modal__total-text {
    color: rgb(240, 240, 245);
    font-size: 28px;
    -unity-font-style: bold;
}

.buy-modal__confirm {
    width: 80%;
    height: 84px;
    border-radius: 18px;
    background-color: rgb(250, 188, 60);
    border-width: 0;
    color: rgb(60, 35, 5);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    padding: 0;
}

.buy-modal__confirm--ok {
    background-color: rgb(80, 200, 100);
    color: rgb(255, 255, 255);
}

.buy-modal__confirm:hover {
    background-color: rgb(255, 215, 110);
}

/* ============================================================
 * Shop top stat pills — 用 tab-btn 同款简单边框（不再用 sprite 9-slice）
 * 三个 pill：最高分 / 当前分 / 金币
 * ============================================================ */

.top-bar {
    margin-top: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-pill {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 96px;
    min-width: 220px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    padding-left: 14px;
    padding-right: 22px;
    /* 跟 .tab-btn 一致：border + 圆角 + 半透明深蓝填充 */
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.4);
    border-radius: 28px;
    background-color: rgba(15, 22, 50, 0.7);
}

.stat-pill__value {
    flex-grow: 0;
    flex-shrink: 0;
    color: rgb(240, 240, 245);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 6px;
    margin-right: 6px;
    white-space: nowrap;
}

.stat-pill__icon {
    width: 56px;
    height: 56px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-pill__icon--flag {
    background-image: url("project://database/Assets/UI/Sprites/game-top-bar-icon.png?fileID=-437439192&guid=937f9d3437a150a4b831fb186a9ebc04&type=3#highscore");
}

.stat-pill__icon--gem {
    background-image: url("project://database/Assets/UI/Sprites/game-top-bar-icon.png?fileID=1239169367&guid=937f9d3437a150a4b831fb186a9ebc04&type=3#current-score");
}

.stat-pill__icon--coin {
    background-image: url("project://database/Assets/UI/Sprites/game-top-bar-icon.png?fileID=542907808&guid=937f9d3437a150a4b831fb186a9ebc04&type=3#coin");
}

/* ============================================================
 * 让 ITEMS 等内容较少的 tab 不强行拉伸到铺满 ScrollView，
 * 否则 ScrollView 会把 contentContainer 拉到与视口等高，
 * 看起来像“没什么内容也能滚”。
 * ============================================================ */

.shop-scroll {
    flex-grow: 1;
}

.shop-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 0;
}

.tab-content {
    flex-shrink: 0;
}
