/* ============================================================
 * shop.uss — 商店面板专属样式
 * 共享部分（顶栏 / header / section-divider / bottom-nav）
 * 已经在 theme.uss。这里只放 shop 自己用到的。
 * ============================================================ */

/* —— Tab 切换条（BALLS / BLOCKS） —— */
.tab-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 18px;
}

.tab-btn {
    width: 280px;
    height: 96px;
    margin-left: 14px;
    margin-right: 14px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.4);
    border-radius: 28px;
    background-color: rgba(15, 22, 50, 0.7);
    color: rgb(150, 170, 210);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    padding: 0;
}

.tab-btn:hover {
    background-color: rgba(40, 70, 130, 0.7);
}

.tab-btn:active {
    scale: 0.97 0.97;
}

.tab-btn--active {
    background-color: var(--color-play);
    color: var(--color-text-dark);
    border-color: var(--color-play-hi);
}

/* —— 商品网格 —— */
.shop-scroll {
    flex-grow: 1;
}

.item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 8px;
}

.item-card {
    width: 30%;
    height: 320px;
    margin-bottom: 18px;
    background-color: rgba(20, 30, 70, 0.85);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(80, 140, 255, 0.35);
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 14px;
    padding-left: 10px;
    padding-right: 10px;
}

.item-card--selected {
    border-color: rgb(120, 180, 255);
    border-width: 4px;
    background-color: rgba(35, 55, 130, 0.9);
}

.item-card--locked {
    /* 默认外观即“锁定”，预留以后做半透明效果 */
}

/* 商品缩略图占位（六边形球 / 体育球等）——
   后续把背景换成实际 PNG 即可。 */
.item-thumb {
    width: 150px;
    height: 150px;
    border-radius: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-thumb--classic   { background-color: rgb(245, 195, 60);  background-image: url("project://database/Assets/Sprites/HexagonBall.png"); }
.item-thumb--blue      { background-color: rgb(70, 140, 255);  border-radius: 24px; }
.item-thumb--purple    { background-color: rgb(170, 90, 240);  border-radius: 24px; }
.item-thumb--green     { background-color: rgb(80, 200, 110);  border-radius: 24px; }
.item-thumb--red       { background-color: rgb(230, 70, 80);   border-radius: 24px; }
.item-thumb--rainbow   {
    background-color: rgb(160, 110, 230);
    border-radius: 24px;
}
.item-thumb--soccer    { background-color: rgb(240, 240, 240); border-radius: 999px; }
.item-thumb--basket    { background-color: rgb(230, 130, 50);  border-radius: 999px; }
.item-thumb--planet    { background-color: rgb(70, 60, 180);   border-radius: 999px; }

/* 名字 / 价格 标签 */
.item-card__name {
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-top: 4px;
}

.item-card__price {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(80, 50, 160, 0.85);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(150, 110, 240, 0.6);
    height: 56px;
    width: 90%;
    padding-left: 8px;
    padding-right: 12px;
    margin-top: 6px;
}

.item-card__price-coin {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background-color: var(--color-coin);
    margin-right: 8px;
}

.item-card__price-text {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
}

/* 锁标 / 已选标 */
.item-card__lock {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: rgba(220, 220, 230, 0.85);
}

.item-card__check {
    position: absolute;
    bottom: 80px;
    right: 14px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background-color: rgb(70, 200, 90);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}
