<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/theme.uss?fileID=7433441132597879392&amp;guid=17651a3551c5e0f47a351277b58b0376&amp;type=3#theme" />
    <Style src="project://database/Assets/UI/Styles/shop.uss?fileID=7433441132597879392&amp;guid=88faa18ee05cd814d8b21a6b7a26952d&amp;type=3#shop" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="bg-image" picking-mode="Ignore" class="bg-image bg-image--page" />
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--flag" />
                <ui:Label name="high-score-value" text="0" class="stat-pill__value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--gem" />
                <ui:Label name="gem-value" text="0" class="stat-pill__value" />
                <ui:Button name="add-gems-btn" text="+" class="stat-pill__plus" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--coin" />
                <ui:Label name="coin-value" text="0" class="stat-pill__value" />
                <ui:Button name="add-coins-btn" text="+" class="stat-pill__plus" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="header-row">
            <ui:Button name="back-btn" class="back-btn" />
            <ui:VisualElement class="banner">
                <ui:Label text="SHOP" class="banner__title" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="tab-bar">
            <ui:Button name="tab-balls" text="BALLS" class="tab-btn tab-btn--active" />
            <ui:Button name="tab-blocks" text="BLOCKS" class="tab-btn" />
        </ui:VisualElement>
        <ui:ScrollView name="shop-scroll" mode="Vertical" class="shop-scroll">
            <ui:VisualElement class="item-grid">
                <ui:Button name="item-classic" class="item-card item-card--selected">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--classic" />
                    <ui:Label text="CLASSIC" class="item-card__name" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                </ui:Button>
                <ui:Button name="item-blue" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--blue" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="500" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-purple" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--purple" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="800" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-green" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--green" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="1000" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-red" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--red" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="1200" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-rainbow" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--rainbow" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="1500" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="section-divider">
                <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
                <ui:Label text="SPECIAL" class="section-divider__text" />
                <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
            </ui:VisualElement>
            <ui:VisualElement class="item-grid">
                <ui:Button name="item-soccer" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--soccer" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="2000" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-basket" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--basket" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="2000" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="item-planet" class="item-card item-card--locked">
                    <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--planet" />
                    <ui:VisualElement picking-mode="Ignore" class="item-card__lock" />
                    <ui:VisualElement class="item-card__price">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="2500" class="item-card__price-text" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="bottom-nav">
            <ui:Button name="nav-shop" class="nav-btn nav-btn--active">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--shop" />
                <ui:Label text="SHOP" />
            </ui:Button>
            <ui:Button name="nav-settings" class="nav-btn">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--settings" />
                <ui:Label text="SETTING" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
