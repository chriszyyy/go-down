<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/theme.uss?fileID=7433441132597879392&amp;guid=17651a3551c5e0f47a351277b58b0376&amp;type=3#theme" />
    <Style src="project://database/Assets/UI/Styles/shop.uss?fileID=7433441132597879392&amp;guid=88faa18ee05cd814d8b21a6b7a26952d&amp;type=3#shop" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="bg-image" picking-mode="Ignore" class="bg-image bg-image--page" />
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--flag" />
                <ui:Label name="high-score-value" text="789987" class="stat-pill__value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--gem" />
                <ui:Label name="score-value" text="789789" class="stat-pill__value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-pill">
                <ui:VisualElement class="stat-pill__icon stat-pill__icon--coin" />
                <ui:Label name="coin-value" text="456456" class="stat-pill__value" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="header-row">
            <ui:Button name="back-btn" class="back-btn" />
            <ui:VisualElement class="banner">
                <ui:Label text="SHOP" class="banner__title" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="tab-bar tab-bar--five">
            <ui:Button name="tab-balls" text="BALLS" class="tab-btn tab-btn--small" style="display: none;" />
            <ui:Button name="tab-items" text="ITEMS" class="tab-btn tab-btn--small tab-btn--active" />
            <ui:Button name="tab-coins" text="COINS" class="tab-btn tab-btn--small" />
            <ui:Button name="tab-noads" text="NO ADS" class="tab-btn tab-btn--small" />
        </ui:VisualElement>
        <ui:ScrollView name="shop-scroll" mode="Vertical" class="shop-scroll">
            <ui:VisualElement name="content-balls" class="tab-content tab-content--hidden" style="display: none;">
                <ui:VisualElement class="item-grid">
                    <ui:Button name="item-hex-gold" class="item-card">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--hex item-thumb--hex-gold" />
                        <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                        <ui:Label text="GOLD" class="item-card__name" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="500" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="item-hex-blue" class="item-card">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--hex item-thumb--hex-blue" />
                        <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                        <ui:Label text="BLUE" class="item-card__name" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="500" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="item-hex-green" class="item-card">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--hex item-thumb--hex-green" />
                        <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                        <ui:Label text="GREEN" class="item-card__name" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="500" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="item-hex-purple" class="item-card">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--hex item-thumb--hex-purple" />
                        <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                        <ui:Label text="PURPLE" class="item-card__name" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="500" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="item-hex-red" class="item-card">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--hex item-thumb--hex-red" />
                        <ui:VisualElement picking-mode="Ignore" class="item-card__check" />
                        <ui:Label text="RED" class="item-card__name" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="500" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-items" class="tab-content tab-content--active">
                <ui:VisualElement class="section-divider">
                    <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
                    <ui:Label text="TOOLS" class="section-divider__text" />
                    <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
                </ui:VisualElement>
                <ui:VisualElement class="item-grid item-grid--two">
                    <ui:Button name="item-tool-reset" class="item-card item-card--tool">
                        <ui:Label text="RESET BALL" class="item-card__title" />
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--tool-reset" />
                        <ui:Label name="item-reset-count" text="x0" class="item-card__count" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="50" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="item-tool-rainbow" class="item-card item-card--tool">
                        <ui:Label text="RAINBOW BLOCK" class="item-card__title" />
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--tool-rainbow" />
                        <ui:Label name="item-rainbow-count" text="x0" class="item-card__count" />
                        <ui:VisualElement class="item-card__price">
                            <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                            <ui:Label text="35" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="section-divider">
                    <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
                    <ui:Label text="SPECIAL (LOCKED)" class="section-divider__text" />
                    <ui:VisualElement picking-mode="Ignore" class="section-divider__line" />
                </ui:VisualElement>
                <ui:Label text="More items coming soon." class="empty-tab__sub" />
            </ui:VisualElement>
            <ui:VisualElement name="content-coins" class="tab-content tab-content--hidden">
                <ui:VisualElement class="item-grid item-grid--two">
                    <ui:Button name="coin-pack-100" class="item-card item-card--coin">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--coin-pack item-thumb--coin-pack-100" />
                        <ui:Label text="100" class="item-card__title" />
                        <ui:VisualElement class="item-card__price item-card__price--money">
                            <ui:Label text="$0.99" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="coin-pack-500" class="item-card item-card--coin">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--coin-pack item-thumb--coin-pack-500" />
                        <ui:Label text="500 (+65%)" class="item-card__title" />
                        <ui:VisualElement class="item-card__price item-card__price--money">
                            <ui:Label text="$2.99" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="coin-pack-1200" class="item-card item-card--coin">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--coin-pack item-thumb--coin-pack-1200" />
                        <ui:Label text="1200 (+100%)" class="item-card__title" />
                        <ui:VisualElement class="item-card__price item-card__price--money">
                            <ui:Label text="$5.99" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="coin-pack-2500" class="item-card item-card--coin">
                        <ui:VisualElement picking-mode="Ignore" class="item-thumb item-thumb--coin-pack item-thumb--coin-pack-2500" />
                        <ui:Label text="2500 (+150%)" class="item-card__title" />
                        <ui:VisualElement class="item-card__price item-card__price--money">
                            <ui:Label text="$9.99" class="item-card__price-text" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="watch-ad-card">
                    <ui:VisualElement picking-mode="Ignore" class="watch-ad-card__icon" />
                    <ui:VisualElement class="watch-ad-card__text">
                        <ui:Label text="WATCH AD" class="watch-ad-card__title" />
                        <ui:Label text="Get free coins" class="watch-ad-card__sub" />
                    </ui:VisualElement>
                    <ui:VisualElement name="watch-ad-btn-wrap" class="watch-ad-btn-wrap">
                        <ui:Button name="watch-ad-btn" text="FREE" class="watch-ad-btn" />
                        <ui:Label text="AD" picking-mode="Ignore" class="watch-ad-btn__badge" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-noads" class="tab-content tab-content--hidden">
                <ui:VisualElement class="noads-hero">
                    <ui:Label name="noads-hero-title" text="REMOVE ADS" class="noads-hero__title" />
                    <ui:Label text="Enjoy the game without interruptions!" class="noads-hero__subtitle" />
                    <ui:VisualElement name="noads-hero-image" picking-mode="Ignore" class="noads-hero__image" />
                </ui:VisualElement>
                <ui:VisualElement class="noads-features">
                    <ui:VisualElement class="noads-feature">
                        <ui:VisualElement picking-mode="Ignore" class="noads-feature__icon noads-feature__icon--shield" />
                        <ui:Label text="No Banner Ads" class="noads-feature__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="noads-feature">
                        <ui:VisualElement picking-mode="Ignore" class="noads-feature__icon noads-feature__icon--playback" />
                        <ui:Label text="No Interstitial Ads" class="noads-feature__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="noads-feature">
                        <ui:VisualElement picking-mode="Ignore" class="noads-feature__icon noads-feature__icon--rocket" />
                        <ui:Label text="Faster Experience" class="noads-feature__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="noads-spacer" />
                <ui:VisualElement name="noads-lifetime-card" class="noads-lifetime-card">
                    <ui:Label text="LIFETIME ACCESS" class="noads-lifetime-card__title" />
                    <ui:Label text="One-time payment" class="noads-lifetime-card__sub" />
                    <ui:VisualElement picking-mode="Ignore" class="noads-lifetime-card__icon" />
                    <ui:Label text="Pay once, enjoy forever!" class="noads-lifetime-card__tagline" />
                    <ui:Button name="noads-lifetime" text="$2.99" class="noads-price-btn" />
                </ui:VisualElement>
                <ui:VisualElement name="noads-active-card" class="noads-active-card" style="display: none;">
                    <ui:VisualElement picking-mode="Ignore" class="noads-active-card__icon" />
                    <ui:VisualElement class="noads-active-card__text">
                        <ui:Label text="NO ADS - ACTIVE" class="noads-active-card__title" />
                        <ui:Label text="Thank you for supporting the game!" class="noads-active-card__sub" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="noads-restore" class="noads-restore-card">
                    <ui:VisualElement picking-mode="Ignore" class="noads-restore-card__icon" />
                    <ui:VisualElement class="noads-restore-card__text">
                        <ui:Label text="RESTORE PURCHASES" class="noads-restore-card__title" />
                        <ui:Label text="Already purchased? Restore your purchase." class="noads-restore-card__sub" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="bottom-nav">
            <ui:Button name="nav-shop" class="nav-btn nav-btn--active">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--shop" />
                <ui:Label text="SHOP" />
            </ui:Button>
            <ui:Button name="nav-settings" class="nav-btn">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--settings" />
                <ui:Label text="SETTING" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="buy-modal" class="buy-modal buy-modal--hidden">
            <ui:VisualElement class="buy-modal__panel">
                <ui:VisualElement name="buy-view" class="buy-modal__view">
                    <ui:Label text="BUY ITEM" class="buy-modal__title" />
                    <ui:Button name="buy-close" text="X" class="buy-modal__close" />
                    <ui:VisualElement name="buy-icon" picking-mode="Ignore" class="buy-modal__icon item-thumb--tool-reset" />
                    <ui:Label name="buy-item-name" text="ITEM" class="buy-modal__item-name" />
                    <ui:Label name="buy-prompt" text="Do you want to buy this item?" class="buy-modal__prompt" />
                    <ui:VisualElement class="buy-modal__qty-row">
                        <ui:Button name="buy-qty-minus" text="−" class="buy-modal__qty-btn" />
                        <ui:Label name="buy-qty-value" text="1" class="buy-modal__qty-value" />
                        <ui:Button name="buy-qty-plus" text="+" class="buy-modal__qty-btn" />
                        <ui:Button name="buy-qty-max" text="MAX" class="buy-modal__qty-max" />
                    </ui:VisualElement>
                    <ui:VisualElement class="buy-modal__total">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label name="buy-total" text="500" class="buy-modal__total-text" />
                    </ui:VisualElement>
                    <ui:Button name="buy-confirm" text="CONFIRM" class="buy-modal__confirm" />
                </ui:VisualElement>
                <ui:VisualElement name="skin-view" class="buy-modal__view buy-modal__view--hidden">
                    <ui:Label text="UNLOCK SKIN" class="buy-modal__title" />
                    <ui:Button name="skin-close" text="X" class="buy-modal__close" />
                    <ui:VisualElement name="skin-icon" picking-mode="Ignore" class="buy-modal__icon item-thumb--hex item-thumb--hex-blue" />
                    <ui:Label name="skin-prompt" text="Unlock this hexagon skin for 500 coins?" class="buy-modal__prompt" />
                    <ui:VisualElement class="buy-modal__total">
                        <ui:VisualElement picking-mode="Ignore" class="item-card__price-coin" />
                        <ui:Label text="500" class="buy-modal__total-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="buy-modal__skin-actions">
                        <ui:Button name="skin-cancel" text="CANCEL" class="buy-modal__cancel" />
                        <ui:Button name="skin-confirm" text="CONFIRM" class="buy-modal__confirm" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="iap-view" class="buy-modal__view buy-modal__view--hidden">
                    <ui:Label name="iap-title" text="BUY COINS" class="buy-modal__title" />
                    <ui:Button name="iap-close" text="X" class="buy-modal__close" />
                    <ui:VisualElement name="iap-icon" picking-mode="Ignore" class="buy-modal__icon item-thumb--coin-pack" />
                    <ui:Label name="iap-prompt" text="Purchase this coin pack?" class="buy-modal__prompt" />
                    <ui:VisualElement class="buy-modal__total">
                        <ui:Label name="iap-price" text="$0.99" class="buy-modal__total-text" />
                    </ui:VisualElement>
                    <ui:Label text="Dev mode: purchase succeeds locally." class="buy-modal__dev-note" />
                    <ui:VisualElement class="buy-modal__skin-actions">
                        <ui:Button name="iap-cancel" text="CANCEL" class="buy-modal__cancel" />
                        <ui:Button name="iap-confirm" text="CONFIRM" class="buy-modal__confirm" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="bought-view" class="buy-modal__view buy-modal__view--hidden">
                    <ui:Label text="PURCHASED!" class="buy-modal__title" />
                    <ui:VisualElement name="bought-icon" picking-mode="Ignore" class="buy-modal__icon item-thumb--tool-reset" />
                    <ui:Label name="bought-summary" text="You now have 0" class="buy-modal__prompt" />
                    <ui:Button name="buy-ok" text="OK" class="buy-modal__confirm buy-modal__confirm--ok" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
