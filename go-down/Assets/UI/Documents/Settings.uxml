<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/theme.uss?fileID=7433441132597879392&amp;guid=17651a3551c5e0f47a351277b58b0376&amp;type=3#theme" />
    <Style src="project://database/Assets/UI/Styles/settings.uss?fileID=7433441132597879392&amp;guid=556a4e9a7714dc042b5af5ded8a449e4&amp;type=3#settings" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="bg-image" picking-mode="Ignore" class="bg-image bg-image--page" />
        <ui:VisualElement class="header-row">
            <ui:Button name="back-btn" class="back-btn" />
            <ui:VisualElement class="banner">
                <ui:Label text="SETTING" class="banner__title" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="settings-scroll" mode="Vertical" class="settings-scroll">
            <ui:VisualElement class="section-card">
                <ui:Label text="AUDIO" class="section-title" />
                <ui:VisualElement class="audio-row">
                    <ui:VisualElement picking-mode="Ignore" class="audio-icon audio-icon--music" />
                    <ui:Label text="MUSIC" class="audio-label" />
                    <ui:Slider name="music-slider" low-value="0" high-value="1" value="0.7" class="audio-slider" />
                    <ui:Toggle name="music-toggle" value="true" class="audio-toggle" />
                </ui:VisualElement>
                <ui:VisualElement class="audio-row">
                    <ui:VisualElement picking-mode="Ignore" class="audio-icon audio-icon--sfx" />
                    <ui:Label text="SFX" class="audio-label" />
                    <ui:Slider name="sfx-slider" low-value="0" high-value="1" value="0.5" class="audio-slider" />
                    <ui:Toggle name="sfx-toggle" value="true" class="audio-toggle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="bottom-nav">
            <ui:Button name="nav-shop" class="nav-btn">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--shop" />
                <ui:Label text="SHOP" />
            </ui:Button>
            <ui:Button name="nav-settings" class="nav-btn nav-btn--active">
                <ui:VisualElement picking-mode="Ignore" class="nav-icon nav-icon--settings" />
                <ui:Label text="SETTING" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
