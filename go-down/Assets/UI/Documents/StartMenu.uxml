<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/theme.uss?fileID=7433441132597879392&amp;guid=17651a3551c5e0f47a351277b58b0376&amp;type=3#theme" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="bg-image" class="bg-image" picking-mode="Ignore" />
        <ui:VisualElement name="middle-row" class="middle-row">
            <ui:VisualElement class="center-stack">
                <ui:Label text="GO" class="logo" />
                <ui:Label text="DOWN" class="logo" />
                <ui:Label text="点击消除，让六边形小球不断下落！" class="subtitle" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-actions" class="bottom-actions">
            <ui:Button name="play-btn" class="btn btn--play">
                <ui:VisualElement class="btn__icon" />
                <ui:Label text="START GAME" class="btn__label" />
            </ui:Button>
            <ui:Button name="shop-btn" class="btn btn--shop">
                <ui:VisualElement class="btn__icon" />
                <ui:Label text="SHOP" class="btn__label" />
            </ui:Button>
            <ui:Button name="options-btn" class="btn btn--settings">
                <ui:VisualElement class="btn__icon" />
                <ui:Label text="SETTING" class="btn__label" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
